# ============ 服务端口（HTTP + WebSocket 同端口） ============
# 密钥只放本文件（已 gitignore）。勿写入 IDEA Run Configuration / workspace.xml，勿提交仓库。
APP_HOST=0.0.0.0
APP_PORT=7050
APP_ENV=development
# Enable only for the isolated local Agent write-evidence suite.  The fixture
# is rejected when APP_ENV=production and is never read by normal user traffic.
AI_EVAL_ENABLE_WRITE_FIXTURES=false
# Enables short-lived, request-bound fault capabilities for the isolated local
# resilience matrix. Production rejects this setting unconditionally.
AI_EVAL_ENABLE_FAULT_INJECTION=false
APP_VERSION=dev
APP_RELOAD=false
ALLOW_DEVELOPMENT_AUTH_BYPASS=false
# Java 仅经 Gateway；/internal/** 与 /api/** 共用 JAVA_WEB_URL
JAVA_WEB_URL=http://localhost:8080
AISHOP_INTERNAL_TOKEN=your-token
AISHOP_ADMIN_ASSERTION_CURRENT_SECRET=your-token
# Exact browser origins for cookie-authenticated WS/HTTP requests. A comma
# separated list is accepted; wildcard (*) is intentionally not supported.
WS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_PROTECTION_ENABLED=true
# Trust-boundary limits (the Java/Gateway limits remain an outer layer).
HTTP_MAX_REQUEST_BYTES=262144
WS_MAX_FRAME_BYTES=65536
WS_RATE_LIMIT_WINDOW_SECONDS=60
WS_RATE_LIMIT_MAX_MESSAGES=120
WS_SEND_TIMEOUT_SECONDS=2
PILOT_IDENTITY_HMAC_SECRET=development-only-pilot-secret
PRIVACY_EXPORT_SIGNING_SECRET=development-only-privacy-secret
PRIVACY_EXPORT_DIR=.privacy-exports
PRIVACY_EXPORT_TTL_SECONDS=86400
# MCP Streamable HTTP（独立进程 python -m app.mcp_server，默认 :7060/mcp）
MCP_SERVER_URL=http://127.0.0.1:7060

# ============ OpenTelemetry（可选；未配置 OTLP 地址时保持关闭） ============
OTEL_ENABLED=false
OTEL_SERVICE_NAME=aishop-agent
OTEL_OTLP_ENDPOINT=
TEMPO_QUERY_URL=http://localhost:3000/explore

# ============ Agent Episode（应用级轨迹，写入失败不影响业务） ============
EPISODE_ENABLED=true
EPISODE_QUEUE_SIZE=2000
EPISODE_BATCH_SIZE=100
EPISODE_FLUSH_INTERVAL_MS=200
# development 环境始终保留完整轨迹；其他环境普通成功请求按此比例保留步骤。
EPISODE_SUCCESS_SAMPLE_RATE=0.10
EPISODE_RETENTION_DAYS=30

# ============ Shadow LLM Judge（显式配置模型后才启用） ============
JUDGE_MODEL=
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_TIMEOUT=15
JUDGE_SAMPLE_RATE=0.05
JUDGE_LOW_SCORE_THRESHOLD=0.65
JUDGE_QUEUE_SIZE=500

# ============ LLM ============
# 留空表示未配置；不要使用看似真实但实际无效的占位 Key。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# Optional independent fallback provider; blank fields inherit the primary.
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=deepseek-chat
LLM_TIMEOUT=20
LLM_MAX_RETRIES=1
LLM_FALLBACK_TIMEOUT=
# Blank inherits the primary factory default; interactive fallback defaults to 0.
LLM_FALLBACK_MAX_RETRIES=0
LLM_PRICING_CNY_PER_MILLION_JSON={}

# Evaluation-only bounded provider calls. Failed attempts remain visible in
# usage evidence; a missing usage object never becomes a zero-cost claim.
AI_EVAL_RAG_LLM_TIMEOUT_SECONDS=60
AI_EVAL_RAG_LLM_RETRIES=1
AI_EVAL_RAG_LLM_RETRY_BACKOFF_SECONDS=0.25
AI_EVAL_SEMANTIC_JUDGE_MODEL=
AI_EVAL_SEMANTIC_JUDGE_TIMEOUT_SECONDS=30
AI_EVAL_SEMANTIC_JUDGE_RETRIES=1

# ============ 记忆摘要 LLM（可与主对话分离；留空则回落主 LLM） ============
MEMORY_LLM_API_KEY=
MEMORY_LLM_BASE_URL=
MEMORY_LLM_MODEL=
MEMORY_LLM_TIMEOUT=
# Hard cap for the auxiliary intent call; it must not consume the full Agent deadline.
INTENT_LLM_TIMEOUT_SECONDS=8
# auto=provider capability detection; use disabled for providers without JSON schema support.
INTENT_STRUCTURED_OUTPUT_MODE=auto

# ============ Embedding ============
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Java Search appends this path; Python Agent ignores it.
EMBEDDING_PATH=/embeddings
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
VECTOR_INDEX_SCHEMA_VERSION=1

# ============ 知识图片理解（可选） ============
# 专用 VLM_API_KEY 优先；也可通过 DASHSCOPE_API_KEY 作为共享 Key 回退。
# 该模型用于知识文档图片理解；用户“传图找同款”使用下方独立的视觉商品搜索配置。
# Java Search 处理知识文档图片时，还需将 VLM_ENABLED 改为 true。
VLM_ENABLED=false
VLM_API_KEY=
DASHSCOPE_API_KEY=
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen-vl-plus
VLM_IMAGE_MAX_TOKENS=150
VLM_CONNECT_TIMEOUT_SECONDS=5
VLM_TIMEOUT=15

# ============ Rerank（阿里云百炼，华北 2/北京） ============
# 在百炼控制台创建业务空间后，同时填写 Key 并替换 URL 中的 YOUR_WORKSPACE_ID。
# qwen3-rerank 使用 compatible 协议；gte-rerank-v2 / qwen3-vl-rerank 可改用
# dashscope_native，并换成对应的 /api/v1/services/rerank/... 完整端点。
RERANK_API_KEY=
RERANK_API_FORMAT=compatible
RERANK_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-api/v1/reranks
RERANK_MODEL=qwen3-rerank
RERANK_INSTRUCT="根据候选内容是否能直接回答、约束或明确否定用户命题排序。仅主题相似但不能回答的内容必须低分。"
RERANK_TIMEOUT=20
RERANK_TOP_N=6
# 本地未填 Key 时允许回退 RRF；生产环境应设为 true。
RERANK_REQUIRED=false

# ============ 视觉商品搜索（默认启用，未配置云密钥时自动降级） ============
# 用户上传的图片只以服务端审核后的 imageAssetId 流转；不会向模型暴露存储路径或 URL。
# VISUAL_API_KEY 留空时会回退 EMBEDDING_API_KEY / DASHSCOPE_API_KEY。
# 无可用 Key 时 Worker 不绑定视觉队列，并清理旧积压；配置 Key 后通过全量回灌恢复派生索引。
VISUAL_SEARCH_ENABLED=true
VISUAL_INDEX_CONSUMER_ENABLED=true
VISUAL_API_KEY=
VISUAL_GROUNDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISUAL_GROUNDING_MODEL=qwen3-vl-plus
VISUAL_GROUNDING_TIMEOUT_SECONDS=8
VISUAL_EMBEDDING_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
VISUAL_EMBEDDING_MODEL=qwen3-vl-embedding
VISUAL_EMBEDDING_DIMENSIONS=1024
VISUAL_EMBEDDING_TIMEOUT_SECONDS=10
# 留空时复用 RERANK_API_KEY / DASHSCOPE_API_KEY；URL 留空时从 RERANK_BASE_URL 推导百炼 Workspace 地址。
VISUAL_RERANK_API_KEY=
VISUAL_RERANK_BASE_URL=
VISUAL_RERANK_MODEL=qwen3-vl-rerank
VISUAL_RERANK_TIMEOUT_SECONDS=12
VISUAL_PROVIDER_DEADLINE_SECONDS=20
VISUAL_INDEX_ALIAS=aishop_visual_products
VISUAL_INDEX_PREFIX=aishop_visual_products_v
VISUAL_INDEX_MODEL_VERSION=qwen3-vl-embedding-1024-v1
VISUAL_EMBEDDING_MIN_COSINE=0.45
VISUAL_INDEX_EXCHANGE=rag.exchange
VISUAL_INDEX_QUEUE=visual.index.queue
VISUAL_INDEX_DEAD_LETTER_QUEUE=visual.index.dlq
VISUAL_INDEX_ROUTING_KEY=rag.queue
VISUAL_INDEX_CONSUMER_CONCURRENCY=1
VISUAL_INDEX_MAX_RETRIES=3
VISUAL_INDEX_RETRY_BACKOFF_SECONDS=2
# 仅当 VISUAL_API_KEY（或其回退 Key）存在时，Worker 才异步构建当前模型版本的全量索引。
VISUAL_INDEX_BACKFILL_ON_START=true

# ============ MySQL（复用 Java 库） ============
MYSQL_HOST=localhost
MYSQL_PORT=3306
# 一键启动会在 run/runtime.env 中生成并持久化非 root 业务账号。
MYSQL_USER=aishop
MYSQL_PASSWORD=
MYSQL_DATABASE=aishop_agent
MYSQL_POOL_MIN_SIZE=1
MYSQL_POOL_MAX_SIZE=8
MYSQL_POOL_RECYCLE_SECONDS=1800

# ============ Redis ============
REDIS_HOST=127.0.0.1
# 宿主机端口是 6380（compose 里 6380:6379，避开本机已装的 Redis）
REDIS_PORT=6380
REDIS_DB=0
# start.sh 会生成并持久化本地密码；独立启动 Agent 时应与 Redis 实例保持一致。
REDIS_USERNAME=default
REDIS_PASSWORD=
# 托管 Redis 使用 TLS 时设为 true，连接协议将切换为 rediss://。
REDIS_SSL_ENABLED=false

# ============ Elasticsearch ============
ES_HOSTS=http://localhost:9200
# 生产环境必须使用 HTTPS、独立最小权限账号并保持证书校验开启。
ES_USERNAME=
ES_PASSWORD=
ES_VERIFY_SSL=true
ES_INDEX=aishop_vectorstore
VECTOR_FIELD=embedding
ES_VECTOR_DIMENSIONS=1024

# ============ RabbitMQ（与 deploy/docker-compose.middleware.yml 一致） ============
# 宿主机端口是 5673（compose 里 5673:5672）；端口和账号都写在 DSN 里，
# 光 export RABBIT_PORT 不管用，必须整条改。
RABBITMQ_URL=amqp://aishop:aishop@localhost:5673/
RABBITMQ_QUEUE_TYPE=quorum

# ============ Agent 配置 ============
MULTI_AGENT_ENABLED=true
AGENT_BUDGET_ENABLED=true
AGENT_BUDGET_MAX_TOKENS=16000
AGENT_BUDGET_MAX_COST_CNY=1.0
AGENT_BUDGET_MAX_STEPS=16
AGENT_BUDGET_DEADLINE_SECONDS=60
AGENT_BUDGET_WARN_THRESHOLD=0.8
# Whole-call wall-clock cap, including Provider SDK retries. This is distinct
# from the SDK's per-network-operation LLM_TIMEOUT.
AGENT_LLM_CALL_DEADLINE_SECONDS=25
# Latency ablation only; keep false unless a paired evaluation explicitly
# records quality/safety parity for the low-risk read-only first turn.
AGENT_FAST_SUPPORT_MODE=false
AGENT_FAST_SUPPORT_MAX_TOKENS=512
ORCHESTRATION_MODE=adaptive
DATA_ANALYST_ENABLED=true
SHOPPING_DECISION_V2_ENABLED=true
PRODUCT_SEARCH_DEADLINE_SECONDS=8
PRODUCT_SEARCH_PROVIDER_TIMEOUT_SECONDS=4
OUTCOME_LEDGER_ENABLED=true
AFTER_SALES_POLICY_ENGINE_ENABLED=true
INVENTORY_OPS_ENABLED=true
COMMERCE_OUTCOME_ATTRIBUTION_DAYS=30
MULTI_AGENT_SPECIALIST_MAX_ROUNDS=2
ANALYTICS_MYSQL_HOST=localhost
ANALYTICS_MYSQL_PORT=3306
ANALYTICS_MYSQL_USER=analytics_reader
ANALYTICS_MYSQL_PASSWORD=
ANALYTICS_MYSQL_DATABASE=aishop_admin
ANALYTICS_MYSQL_POOL_MIN_SIZE=1
ANALYTICS_MYSQL_POOL_MAX_SIZE=2
ANALYTICS_MAX_ROWS=200
ANALYTICS_MAX_DAYS=90
ANALYTICS_QUERY_TIMEOUT_MS=3000
ANALYTICS_MODEL_TIMEOUT_SECONDS=10
ANALYTICS_REQUEST_TIMEOUT_SECONDS=45
AI_CHAT_LIMIT=200
# Worker 是独立进程：任务/队列指标只在这里更新，Prometheus 抓这个端口。
# 修改 APP_PORT 或本项时，也要同步修改 deploy/prometheus/prometheus.yml 的抓取目标。
WORKER_METRICS_PORT=7051
# 任务租约时长（秒）：至少 30 秒且必须短于总 deadline。正常 Worker 持续续租；
# Worker 崩溃后租约到期，recover_pending 才能在 deadline 内接管并完成任务。
AGENT_TASK_LEASE_SECONDS=30
AGENT_TASK_DISPATCH_TIMEOUT_SECONDS=30
# 悬挂待确认动作（EXECUTING 超时未收到终态）的补偿：超过此阈值查询
# Java 幂等账本和订单领域状态；不确定结果保持 EXECUTING，禁止自动重试
PENDING_ACTION_STALE_SECONDS=600
PENDING_ACTION_RECONCILE_INTERVAL_SECONDS=300
PENDING_ACTION_RECONCILE_MAX_ATTEMPTS=6
PENDING_ACTION_RECONCILE_DEADLINE_SECONDS=3600
# 语义缓存命中按此比例抽样进盲评队列（1% 命中会被记录，
# 离线抽样看误报率；0 表示关闭抽样）
RAG_CACHE_SAMPLE_RATE=0.01
RAG_TOP_K=15
# 可选 LLM 查询扩展：已有确定性业务别名时自动短路；远程扩展仅用于无别名/低覆盖场景。
RAG_QUERY_EXPANSION_ENABLED=true
RAG_QUERY_EXPANSION_TIMEOUT_SECONDS=3
# prefetch=固定预取；conditional=预取失败或复杂问题时允许二次检索；agentic=由 Agent 检索。
RAG_MODE=conditional
# 兼容旧部署：仅当未配置 RAG_MODE 时，AGENTIC_RAG=true/false 映射为 agentic/prefetch。
# AGENTIC_RAG=false
# 检索阈值分三段，量纲不同不能共用一个值（原 RAG_SCORE_THRESHOLD 已拆分）：
#   前两个是 cosine 相似度下限，不是 ES 的 _score（ES 打分是 (1+cos)/2）
RAG_VECTOR_MIN_COSINE=0.30
RAG_PRODUCT_VECTOR_MIN_COSINE=0.20
#   rerank 之后的归一化相关性（0~1）
RAG_EVIDENCE_MIN_RELEVANCE=0.70
RAG_EVIDENCE_CANONICAL_HINT_FLOOR=0.55
RAG_EVIDENCE_TOP_SCORE_MARGIN=0.10
#   无 rerank 时的兜底：要求至少在某一路召回里进了前 N 名
#   注意：此值与代码默认值必须一致（3），旧值 10 几乎不过滤任何内容
#   （冻结会话评测限制与变更记录/retriever 注释里有换算：N=10 ⇔ 进前 10 都通过）
RAG_EVIDENCE_MIN_RRF_RANK=3
FORCE_MCP_ON_LLM_SKIP=true
HISTORY_MESSAGE_LIMIT=15
TASK_QUEUE_MAX=300
WORKING_TOKEN_BUDGET=16000
COMPRESS_TOKEN_THRESHOLD=12000

# ============ 熔断 ============
CIRCUIT_LLM_FAILURE_THRESHOLD=5
CIRCUIT_LLM_RECOVERY_TIMEOUT=60
