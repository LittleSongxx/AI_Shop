# ============ 服务端口（HTTP + WebSocket 同端口） ============
# 密钥只放本文件（已 gitignore）。勿写入 IDEA Run Configuration / workspace.xml，勿提交仓库。
APP_HOST=0.0.0.0
APP_PORT=7050
APP_ENV=development
APP_VERSION=dev
APP_RELOAD=false
ALLOW_DEVELOPMENT_AUTH_BYPASS=false
# Java 仅经 Gateway；/internal/** 与 /api/** 共用 JAVA_WEB_URL
JAVA_WEB_URL=http://localhost:8080
AISHOP_INTERNAL_TOKEN=your-token
# MCP Streamable HTTP（独立进程 python -m app.mcp_server，默认 :7060/mcp）
MCP_SERVER_URL=http://127.0.0.1:7060

# ============ OpenTelemetry（可选；未配置 OTLP 地址时保持关闭） ============
OTEL_ENABLED=false
OTEL_SERVICE_NAME=aishop-agent
OTEL_OTLP_ENDPOINT=
TEMPO_QUERY_URL=http://localhost:3000/explore

# ============ Agent Episode（应用级轨迹，写入失败不影响业务） ============
EPISODE_ENABLED=true
EPISODE_QUEUE_SIZE=2000
EPISODE_BATCH_SIZE=100
EPISODE_FLUSH_INTERVAL_MS=200
# development 环境始终保留完整轨迹；其他环境普通成功请求按此比例保留步骤。
EPISODE_SUCCESS_SAMPLE_RATE=0.10
EPISODE_RETENTION_DAYS=30

# ============ Shadow LLM Judge（显式配置模型后才启用） ============
JUDGE_MODEL=
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_TIMEOUT=15
JUDGE_SAMPLE_RATE=0.05
JUDGE_LOW_SCORE_THRESHOLD=0.65
JUDGE_QUEUE_SIZE=500

# ============ LLM ============
# 留空表示未配置；不要使用看似真实但实际无效的占位 Key。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_FALLBACK_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_PRICING_CNY_PER_MILLION_JSON={}

# ============ 记忆摘要 LLM（可与主对话分离；留空则回落主 LLM） ============
MEMORY_LLM_API_KEY=
MEMORY_LLM_BASE_URL=
MEMORY_LLM_MODEL=
MEMORY_LLM_TIMEOUT=

# ============ Embedding ============
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Java Search appends this path; Python Agent ignores it.
EMBEDDING_PATH=/embeddings
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# ============ 视觉模型（可选；用户图片/知识文档图片理解） ============
# 专用 VLM_API_KEY 优先；也可通过 DASHSCOPE_API_KEY 作为共享 Key 回退。
# Python 图片描述器可理解内部消息中的可访问 imageUrl；当前公开 sendMessage 接口与
# 商城聊天表单仍仅接收文本，因此尚未形成端到端的图片聊天能力。
# Java Search 处理知识文档图片时，还需将 VLM_ENABLED 改为 true。
VLM_ENABLED=false
VLM_API_KEY=
DASHSCOPE_API_KEY=
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen-vl-plus
VLM_IMAGE_MAX_TOKENS=150
VLM_CONNECT_TIMEOUT_SECONDS=5
VLM_TIMEOUT=15

# ============ Rerank（阿里云百炼，华北 2/北京） ============
# 在百炼控制台创建业务空间后，同时填写 Key 并替换 URL 中的 YOUR_WORKSPACE_ID。
# qwen3-rerank 使用 compatible 协议；gte-rerank-v2 / qwen3-vl-rerank 可改用
# dashscope_native，并换成对应的 /api/v1/services/rerank/... 完整端点。
RERANK_API_KEY=
RERANK_API_FORMAT=compatible
RERANK_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-api/v1/reranks
RERANK_MODEL=qwen3-rerank
RERANK_INSTRUCT="Given an e-commerce shopping or support query, rank the candidate passages by relevance to the user's intent."
RERANK_TIMEOUT=20
RERANK_TOP_N=6
# 本地未填 Key 时允许回退 RRF；生产环境应设为 true。
RERANK_REQUIRED=false

# ============ MySQL（复用 Java 库） ============
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=aishop_agent

# ============ Redis ============
REDIS_HOST=127.0.0.1
# 宿主机端口是 6380（compose 里 6380:6379，避开本机已装的 Redis）
REDIS_PORT=6380
REDIS_DB=0

# ============ Elasticsearch ============
ES_HOSTS=http://localhost:9200
ES_INDEX=aishop_vectorstore
VECTOR_FIELD=embedding
ES_VECTOR_DIMENSIONS=1024

# ============ RabbitMQ（与 deploy/docker-compose.middleware.yml 一致） ============
# 宿主机端口是 5673（compose 里 5673:5672）；端口和账号都写在 DSN 里，
# 光 export RABBIT_PORT 不管用，必须整条改。
RABBITMQ_URL=amqp://aishop:aishop@localhost:5673/

# ============ Agent 配置 ============
AI_CHAT_LIMIT=200
# Worker 是独立进程：任务/队列指标只在这里更新，Prometheus 抓这个端口。
# 修改 APP_PORT 或本项时，也要同步修改 deploy/prometheus/prometheus.yml 的抓取目标。
WORKER_METRICS_PORT=7051
# 任务租约时长（秒）：至少 30 秒且必须短于总 deadline。正常 Worker 持续续租；
# Worker 崩溃后租约到期，recover_pending 才能在 deadline 内接管并完成任务。
AGENT_TASK_LEASE_SECONDS=30
AGENT_TASK_DISPATCH_TIMEOUT_SECONDS=30
# 悬挂待确认动作（EXECUTING 超时未收到终态）的补偿：超过此阈值查询
# Java 幂等账本和订单领域状态；不确定结果保持 EXECUTING，禁止自动重试
PENDING_ACTION_STALE_SECONDS=600
PENDING_ACTION_RECONCILE_INTERVAL_SECONDS=300
PENDING_ACTION_RECONCILE_MAX_ATTEMPTS=6
PENDING_ACTION_RECONCILE_DEADLINE_SECONDS=3600
# 语义缓存命中按此比例抽样进盲评队列（1% 命中会被记录，
# 离线抽样看误报率；0 表示关闭抽样）
RAG_CACHE_SAMPLE_RATE=0.01
RAG_TOP_K=15
# prefetch=固定预取；conditional=预取失败或复杂问题时允许二次检索；agentic=由 Agent 检索。
RAG_MODE=conditional
# 兼容旧部署：仅当未配置 RAG_MODE 时，AGENTIC_RAG=true/false 映射为 agentic/prefetch。
# AGENTIC_RAG=false
# 检索阈值分三段，量纲不同不能共用一个值（原 RAG_SCORE_THRESHOLD 已拆分）：
#   前两个是 cosine 相似度下限，不是 ES 的 _score（ES 打分是 (1+cos)/2）
RAG_VECTOR_MIN_COSINE=0.30
RAG_PRODUCT_VECTOR_MIN_COSINE=0.20
#   rerank 之后的归一化相关性（0~1）
RAG_EVIDENCE_MIN_RELEVANCE=0.65
#   无 rerank 时的兜底：要求至少在某一路召回里进了前 N 名
#   注意：此值与代码默认值必须一致（3），旧值 10 几乎不过滤任何内容
#   （冻结会话评测限制与变更记录/retriever 注释里有换算：N=10 ⇔ 进前 10 都通过）
RAG_EVIDENCE_MIN_RRF_RANK=3
FORCE_MCP_ON_LLM_SKIP=true
HISTORY_MESSAGE_LIMIT=15
TASK_QUEUE_MAX=300
WORKING_TOKEN_BUDGET=16000
COMPRESS_TOKEN_THRESHOLD=12000

# ============ 熔断 ============
CIRCUIT_LLM_FAILURE_THRESHOLD=5
CIRCUIT_LLM_RECOVERY_TIMEOUT=60
