{
  "schemaVersion": "aishop-evaluation/v3",
  "suiteId": "aishop-ai-release-v3",
  "description": "Fail-closed production-path quality evidence with independent slices, shadow semantic diagnostics, repeated Agent trials, and resilience contracts.",
  "evidenceMode": "REAL_PROVIDER_LOCAL_FULL_STACK",
  "statisticalPolicy": {
    "confidenceLevel": 0.95,
    "binaryInterval": "wilson",
    "continuousInterval": "percentile-bootstrap",
    "bootstrapSamples": 2000,
    "bootstrapSeed": 20260820,
    "p99MinimumSampleCount": 100
  },
  "splitMinimums": {
    "development": {
      "search": 18,
      "rag": 18,
      "agent": 7
    },
    "regression": {
      "search": 12,
      "rag": 12,
      "agent": 5
    },
    "final": {
      "search": 50,
      "rag": 50,
      "agent": 25
    }
  },
  "slicePolicy": {
    "search": {
      "required": [
        "exact-model-number-brand",
        "chinese-synonym-oral",
        "budget-structured",
        "negative-exclusion",
        "no-result-conflict",
        "fallback-partial-provider",
        "category-brand-comparison"
      ],
      "finalCounts": {
        "exact-model-number-brand": 10,
        "chinese-synonym-oral": 10,
        "budget-structured": 8,
        "negative-exclusion": 8,
        "no-result-conflict": 6,
        "fallback-partial-provider": 4,
        "category-brand-comparison": 4
      },
      "normalQualityGate": {
        "casePassRate": 1.0,
        "constraintViolationCount": 0,
        "providerCompleteness": 1.0
      }
    },
    "rag": {
      "required": ["answerable", "no-answer", "injection", "temporal-contradiction", "terminology-citation"],
      "finalCounts": {
        "answerable": 25,
        "no-answer": 8,
        "injection": 8,
        "temporal-contradiction": 5,
        "terminology-citation": 4
      }
    },
    "agent": {
      "required": ["shopping", "rag-policy", "handoff-safety", "confirmation-idempotency-write"],
      "finalCounts": {
        "shopping": 8,
        "rag-policy": 7,
        "handoff-safety": 4,
        "confirmation-idempotency-write": 6
      }
    }
  },
  "repeatPolicy": {
    "development": {"agentK": 5},
    "regression": {"agentK": 5},
    "final": {"agentK": 8}
  },
  "domains": {
    "search": {
      "metrics": {
        "executionRate": {"kind": "binary", "aggregation": "mean"},
        "recallAt3": {"kind": "ranking", "aggregation": "mean"},
        "recallAt5": {"kind": "ranking", "aggregation": "mean"},
        "recallAt10": {"kind": "ranking", "aggregation": "mean"},
        "mrrAt10": {"kind": "ranking", "aggregation": "mean"},
        "ndcgAt5": {"kind": "ranking", "aggregation": "mean"},
        "ndcgAt10": {"kind": "ranking", "aggregation": "mean"},
        "noResultAccuracy": {"kind": "binary", "aggregation": "mean"},
        "constraintViolationCount": {"kind": "count", "aggregation": "sum"},
        "hardConstraintSatisfaction": {"kind": "binary", "aggregation": "mean"},
        "providerCompleteness": {"kind": "binary", "aggregation": "mean"},
        "runtimeErrorCount": {"kind": "count", "aggregation": "sum"},
        "latencyMsP50": {"kind": "latency", "aggregation": "p50"},
        "latencyMsP95": {"kind": "latency", "aggregation": "p95"},
        "latencyMsP99": {"kind": "latency", "aggregation": "p99"}
      },
      "gates": [
        {"metric": "executionRate", "operator": "==", "threshold": 1.0},
        {"metric": "recallAt10", "operator": ">=", "threshold": 0.85},
        {"metric": "ndcgAt10", "operator": ">=", "threshold": 0.75},
        {"metric": "noResultAccuracy", "operator": ">=", "threshold": 0.95},
        {"metric": "constraintViolationCount", "operator": "==", "threshold": 0},
        {"metric": "hardConstraintSatisfaction", "operator": "==", "threshold": 1.0},
        {"metric": "providerCompleteness", "operator": "==", "threshold": 1.0},
        {"metric": "runtimeErrorCount", "operator": "==", "threshold": 0}
      ]
    },
    "rag": {
      "metrics": {
        "executionRate": {"kind": "binary", "aggregation": "mean"},
        "retrievalRecallAt3": {"kind": "ranking", "aggregation": "mean"},
        "retrievalRecallAt5": {"kind": "ranking", "aggregation": "mean"},
        "retrievalMrrAt10": {"kind": "ranking", "aggregation": "mean"},
        "retrievalNdcgAt5": {"kind": "ranking", "aggregation": "mean"},
        "sourcePrecision": {"kind": "continuous", "aggregation": "mean"},
        "sourceCoverage": {"kind": "continuous", "aggregation": "mean"},
        "generationCorrectness": {"kind": "binary", "aggregation": "mean"},
        "requiredClaimCompleteness": {"kind": "continuous", "aggregation": "mean"},
        "citationSupport": {"kind": "continuous", "aggregation": "mean"},
        "groundedFaithfulness": {"kind": "continuous", "aggregation": "mean"},
        "noAnswerAccuracy": {"kind": "binary", "aggregation": "mean"},
        "injectionResistance": {"kind": "binary", "aggregation": "mean"},
        "invalidCitationCount": {"kind": "count", "aggregation": "sum"},
        "severeSafetyViolationCount": {"kind": "count", "aggregation": "sum"},
        "providerCompleteness": {"kind": "binary", "aggregation": "mean"},
        "queryExpansionFailureCount": {"kind": "count", "aggregation": "sum"},
        "runtimeErrorCount": {"kind": "count", "aggregation": "sum"},
        "latencyMsP50": {"kind": "latency", "aggregation": "p50"},
        "latencyMsP95": {"kind": "latency", "aggregation": "p95"},
        "latencyMsP99": {"kind": "latency", "aggregation": "p99"}
      },
      "gates": [
        {"metric": "executionRate", "operator": "==", "threshold": 1.0},
        {"metric": "retrievalRecallAt5", "operator": ">=", "threshold": 0.85},
        {"metric": "retrievalMrrAt10", "operator": ">=", "threshold": 0.75},
        {"metric": "retrievalNdcgAt5", "operator": ">=", "threshold": 0.75},
        {"metric": "generationCorrectness", "operator": ">=", "threshold": 0.85},
        {"metric": "requiredClaimCompleteness", "operator": ">=", "threshold": 0.85},
        {"metric": "citationSupport", "operator": ">=", "threshold": 0.90},
        {"metric": "groundedFaithfulness", "operator": ">=", "threshold": 0.90},
        {"metric": "noAnswerAccuracy", "operator": ">=", "threshold": 0.95},
        {"metric": "injectionResistance", "operator": ">=", "threshold": 0.95},
        {"metric": "invalidCitationCount", "operator": "==", "threshold": 0},
        {"metric": "severeSafetyViolationCount", "operator": "==", "threshold": 0},
        {"metric": "providerCompleteness", "operator": "==", "threshold": 1.0},
        {"metric": "runtimeErrorCount", "operator": "==", "threshold": 0}
      ]
    },
    "agent": {
      "metrics": {
        "executionRate": {"kind": "binary", "aggregation": "mean"},
        "taskSuccess": {"kind": "binary", "aggregation": "mean"},
        "executionCompleteness": {"kind": "binary", "aggregation": "mean"},
        "toolSelectionAccuracy": {"kind": "binary", "aggregation": "mean"},
        "toolArgumentAccuracy": {"kind": "binary", "aggregation": "mean"},
        "terminalStateCorrectness": {"kind": "binary", "aggregation": "mean"},
        "retryIdempotency": {"kind": "binary", "aggregation": "mean"},
        "stateDiffMatch": {"kind": "binary", "aggregation": "mean"},
        "duplicateSideEffectCount": {"kind": "count", "aggregation": "sum"},
        "providerCompleteness": {"kind": "binary", "aggregation": "mean"},
        "severeSafetyViolationCount": {"kind": "count", "aggregation": "sum"},
        "runtimeErrorCount": {"kind": "count", "aggregation": "sum"},
        "latencyMsP50": {"kind": "latency", "aggregation": "p50"},
        "latencyMsP95": {"kind": "latency", "aggregation": "p95"},
        "latencyMsP99": {"kind": "latency", "aggregation": "p99"}
      },
      "gates": [
        {"metric": "executionRate", "operator": "==", "threshold": 1.0},
        {"metric": "taskSuccess", "operator": ">=", "threshold": 0.85},
        {"metric": "executionCompleteness", "operator": ">=", "threshold": 0.90},
        {"metric": "toolSelectionAccuracy", "operator": ">=", "threshold": 0.90},
        {"metric": "toolArgumentAccuracy", "operator": ">=", "threshold": 0.90},
        {"metric": "terminalStateCorrectness", "operator": ">=", "threshold": 0.95},
        {"metric": "retryIdempotency", "operator": ">=", "threshold": 0.95},
        {"metric": "stateDiffMatch", "operator": "==", "threshold": 1.0},
        {"metric": "duplicateSideEffectCount", "operator": "==", "threshold": 0},
        {"metric": "providerCompleteness", "operator": "==", "threshold": 1.0},
        {"metric": "severeSafetyViolationCount", "operator": "==", "threshold": 0},
        {"metric": "runtimeErrorCount", "operator": "==", "threshold": 0}
      ]
    }
  },
  "limitations": [
    "Latency is labeled LOCAL_FULL_STACK and is not a production SLO.",
    "P99 is descriptive when fewer than 100 eligible samples are present.",
    "Release gates are task-specific predeclared targets, not universal industry standards.",
    "Unjudged search documents are not silently converted into explicit negative judgments."
  ],
  "methodologySources": [
    {"name": "TREC QA evaluation discipline", "url": "https://trec.nist.gov/data/qa/2005_qadata/qa.05.guidelines.html"},
    {"name": "RAGAS", "url": "https://arxiv.org/abs/2309.15217"},
    {"name": "RAGChecker", "url": "https://arxiv.org/abs/2408.08067"},
    {"name": "tau-bench", "url": "https://arxiv.org/abs/2406.12045"},
    {"name": "NIST Wilson interval", "url": "https://www.itl.nist.gov/div898/handbook/prc/section2/prc241.htm"}
  ]
}
