# AI_Shop 生产环境变量模板
# 复制为 .env 或注入到 systemd/K8s；上线必须设置 AISHOP_PRODUCTION_READY=true
#
# 完整版（中间件 + 微服务全开）推荐宿主机内存 ≥16G（32G 更从容）；详见 deploy/完整环境启动指南.md

# ---- 总开关 ----
APP_ENV=production
AISHOP_PRODUCTION_READY=true
AISHOP_DEV_LOGIN_BYPASS=false
ALLOW_DEVELOPMENT_AUTH_BYPASS=false

# ---- 基础设施 ----
NACOS_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP
MYSQL_HOST=127.0.0.1
MYSQL_USER=aishop
MYSQL_PASSWORD=CHANGE_ME_STRONG
# First migrate the order/product/stock services and Agent schema. Then run
# provision-flyway-identity.sh before Admin startup. This identity owns the
# governed view definitions and is never used by the Admin request datasource.
FLYWAY_USER=aishop_flyway
FLYWAY_PASSWORD=CHANGE_ME_STRONG_AND_SEPARATE
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
RABBIT_HOST=127.0.0.1
RABBIT_PORT=5672
RABBIT_USER=aishop
RABBIT_PASSWORD=CHANGE_ME_STRONG
RABBIT_VHOST=/
SEATA_CONSOLE_USERNAME=seata
SEATA_CONSOLE_PASSWORD=CHANGE_ME_STRONG
SEATA_SECURITY_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG
SENTINEL_DASHBOARD=127.0.0.1:8858
ES_URIS=http://127.0.0.1:9200
ES_INDEX_REPLICAS=1

# ---- 服务间安全（全服务必须一致）----
AISHOP_INTERNAL_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN
AISHOP_ADMIN_ASSERTION_CURRENT_SECRET=CHANGE_ME_ADMIN_ASSERTION_SECRET
PILOT_IDENTITY_HMAC_SECRET=CHANGE_ME_STABLE_PILOT_IDENTITY_SECRET
PRIVACY_EXPORT_SIGNING_SECRET=CHANGE_ME_PRIVACY_EXPORT_SECRET

# ---- 管理端 ----
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG
ADMIN_EMAILS=ops@example.com

# ---- 业务 ----
PROJECT_FOLDER=/data/aishop/upload
PROJECT_DOMAIN=https://www.example.com
ORDER_EXPIRE_MINUTE=15
ORDER_CONFIRM_MINUTE=10080

# ---- 支付宝（支付必填）----
ALIPAY_APPID=
ALIPAY_SELLER_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_APP_CERT_PATH=/data/aishop/certs/appCertPublicKey.crt
ALIPAY_PUBLIC_CERT_PATH=/data/aishop/certs/alipayCertPublicKey_RSA2.crt
ALIPAY_ROOT_CERT_PATH=/data/aishop/certs/alipayRootCert.crt
ALIPAY_SERVER_URL=https://openapi.alipay.com/gateway.do

# ---- 可选能力 ----
AMAP_KEY=
BAIDU_AIP_ENABLED=false
BAIDU_AIP_API_KEY=
BAIDU_AIP_SECRET_KEY=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_DM_ACCOUNT_NAME=
ALIYUN_DM_REPLY_TO_ADDRESS=false

# ---- 搜索 / RAG（search 服务）----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_FALLBACK_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_PATH=/embeddings
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
VLM_ENABLED=false
VLM_API_KEY=
DASHSCOPE_API_KEY=
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen-vl-plus
VLM_IMAGE_MAX_TOKENS=150
VLM_CONNECT_TIMEOUT_SECONDS=5
VLM_TIMEOUT=15
RERANK_API_KEY=
RERANK_API_FORMAT=compatible
RERANK_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-api/v1/reranks
RERANK_MODEL=qwen3-rerank
RERANK_INSTRUCT="Given an e-commerce shopping or support query, rank the candidate passages by relevance to the user's intent."
RERANK_TIMEOUT=20
RERANK_TOP_N=6
RERANK_REQUIRED=true
VECTOR_INDEX=aishop_vectorstore

# ---- Agent（Python）----
AGENT_HOST=127.0.0.1
AGENT_PORT=7050
AGENT_BASE_URL=http://127.0.0.1:7050
AGENT_ATTRIBUTION_CONNECT_TIMEOUT_MS=200
AGENT_ATTRIBUTION_READ_TIMEOUT_MS=500
JAVA_WEB_URL=http://127.0.0.1:8080
MCP_SERVER_URL=http://127.0.0.1:7060
APP_PORT=7050
ES_INDEX=aishop_vectorstore
# 留空时复用 LLM_API_KEY；仅在使用独立记忆模型时填写。
MEMORY_LLM_API_KEY=
MEMORY_LLM_BASE_URL=
MEMORY_LLM_MODEL=
MEMORY_LLM_TIMEOUT=
MULTI_AGENT_ENABLED=true
DATA_ANALYST_ENABLED=true
MULTI_AGENT_SPECIALIST_MAX_ROUNDS=2
# Provision only after the Admin Flyway migration has created all five views.
ANALYTICS_MYSQL_HOST=127.0.0.1
ANALYTICS_MYSQL_PORT=3306
ANALYTICS_MYSQL_USER=analytics_reader
ANALYTICS_MYSQL_PASSWORD=CHANGE_ME_STRONG_AND_SEPARATE
ANALYTICS_MYSQL_DATABASE=aishop_admin
ANALYTICS_MAX_ROWS=200
ANALYTICS_MAX_DAYS=90
ANALYTICS_QUERY_TIMEOUT_MS=3000
ANALYTICS_MODEL_TIMEOUT_SECONDS=10
ANALYTICS_REQUEST_TIMEOUT_SECONDS=45
