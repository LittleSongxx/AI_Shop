{
  "title": "AI_Shop Overview",
  "uid": "aishop-overview",
  "tags": ["aishop"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "服务",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
        "query": "label_values(http_server_requests_seconds_count, application)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Java 服务（Spring Boot / Micrometer）",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "请求速率（按服务）",
      "description": "http_server_requests_seconds_count 由 Micrometer 自动埋点，无需业务代码改动",
      "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{application=~\"$service\"}[5m]))",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "错误率（5xx / 全部）",
      "description": "outcome 标签由 Micrometer 按响应状态自动打，SERVER_ERROR 即 5xx",
      "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{application=~\"$service\",outcome=\"SERVER_ERROR\"}[5m]))\n/ clamp_min(sum by (application) (rate(http_server_requests_seconds_count{application=~\"$service\"}[5m])), 0.001)",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "响应延迟 p95（按服务）",
      "description": "需要 histogram bucket；若曲线为空，检查是否开启了 percentiles-histogram",
      "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, application) (rate(http_server_requests_seconds_bucket{application=~\"$service\"}[5m])))",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "最慢接口 p95（Top 10）",
      "description": "按 uri 下钻，定位具体慢接口",
      "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, application, uri) (rate(http_server_requests_seconds_bucket{application=~\"$service\"}[5m]))))",
          "legendFormat": "{{application}} {{uri}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM 堆内存使用",
      "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (jvm_memory_used_bytes{application=~\"$service\",area=\"heap\"})",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM 存活线程数",
      "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (jvm_threads_live_threads{application=~\"$service\"})",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "抓取目标存活情况",
      "description": "up 为 0 说明该实例挂了或指标端点没暴露；排查顺序：进程是否在、端口是否对、include 是否含 prometheus",
      "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "short", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"aishop-.*\"}",
          "legendFormat": "{{job}} {{service}} {{instance}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "AI Agent（Python / prometheus_client）",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "意图识别速率（按意图）",
      "description": "source 标签区分识别来源（规则 / 模型），可用于观察规则命中占比",
      "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (intent, source) (rate(agent_intent_total{job=~\"aishop-agent(-worker)?\"}[5m]))",
          "legendFormat": "{{intent}} / {{source}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "工具调用速率（按工具与状态）",
      "description": "status 非 ok 的曲线抬头，通常是下游 MCP 工具或后端接口出问题",
      "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool, status) (rate(agent_tool_call_total{job=~\"aishop-agent(-worker)?\"}[5m]))",
          "legendFormat": "{{tool}} / {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM 调用延迟 p95 / p50",
      "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(agent_llm_latency_seconds_bucket{job=~\"aishop-agent(-worker)?\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(agent_llm_latency_seconds_bucket{job=~\"aishop-agent(-worker)?\"}[5m])))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "RAG 检索延迟 p95 / 平均",
      "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(agent_rag_latency_seconds_bucket{job=~\"aishop-agent(-worker)?\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "sum(rate(agent_rag_latency_seconds_sum{job=~\"aishop-agent(-worker)?\"}[5m])) / clamp_min(sum(rate(agent_rag_latency_seconds_count{job=~\"aishop-agent(-worker)?\"}[5m])), 0.001)",
          "legendFormat": "平均"
        }
      ]
    },
    {
      "type": "stat",
      "title": "RAG 命中率",
      "description": "result 标签为 hit 的占比；持续偏低说明知识库覆盖不足或检索阈值过严",
      "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 42 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(agent_rag_search_total{job=~\"aishop-agent(-worker)?\",result=\"hit\"}[30m])) / clamp_min(sum(rate(agent_rag_search_total{job=~\"aishop-agent(-worker)?\"}[30m])), 0.001)",
          "legendFormat": "命中率"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "熔断器状态",
      "description": "0=closed 1=open 2=half_open；非 0 表示对应下游已被熔断",
      "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 42 },
      "fieldConfig": { "defaults": { "unit": "short", "max": 2, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (breaker) (agent_circuit_state{job=~\"aishop-agent(-worker)?\"})",
          "legendFormat": "{{breaker}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "异步任务队列：处理中 / 积压",
      "description": "积压持续上涨说明消费能力跟不上，需要扩 worker 或查慢任务",
      "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 42 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (agent_task_inflight{job=\"aishop-agent-worker\"})",
          "legendFormat": "处理中 {{queue}}"
        },
        {
          "refId": "B",
          "expr": "max(agent_task_backlog{job=~\"aishop-agent(-worker)?\"})",
          "legendFormat": "数据库积压"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "异步任务结果速率",
      "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 48 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue, result) (rate(agent_task_total{job=\"aishop-agent-worker\"}[5m]))",
          "legendFormat": "{{queue}} / {{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "流式输出字符速率（非 token，成本勿用此面板）",
      "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 48 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(agent_stream_chars_total{job=~\"aishop-agent(-worker)?\"}[5m]))",
          "legendFormat": "chars/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM 调用结果速率",
      "description": "每次真实模型调用只记录一次 success 或 error；按模型和 fallback 状态拆分",
      "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 54 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, fallback, result) (rate(agent_llm_call_total{job=~\"aishop-agent(-worker)?\"}[5m]))",
          "legendFormat": "{{model}} / fallback={{fallback}} / {{result}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "LLM 调用失败率",
      "description": "过去 30 分钟模型调用中 result=error 的占比",
      "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 54 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.02 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(agent_llm_call_total{job=~\"aishop-agent(-worker)?\",result=\"error\"}[30m])) / clamp_min(sum(rate(agent_llm_call_total{job=~\"aishop-agent(-worker)?\"}[30m])), 0.001)",
          "legendFormat": "失败率"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM token 消耗速率",
      "description": "仅统计模型供应商返回的真实 usage；按 input / output、模型和 fallback 拆分",
      "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 60 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind, model, fallback) (rate(agent_llm_tokens_total{job=~\"aishop-agent(-worker)?\"}[5m]))",
          "legendFormat": "{{model}} / fallback={{fallback}} / {{kind}} tokens/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Agent 固定阶段延迟 p95",
      "description": "仅包含 queue_wait / intent / rag / first_token / tool / generation / total 七个固定阶段",
      "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 66 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(agent_stage_latency_seconds_bucket{job=~\"aishop-agent(-worker)?\"}[5m])))",
          "legendFormat": "{{stage}} p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM 人民币成本（最近 1 小时）",
      "description": "只计算 LLM_PRICING_CNY_PER_MILLION_JSON 中明确配置的模型价格；total 为 input + output",
      "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 74 },
      "fieldConfig": { "defaults": { "unit": "currencyCNY" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind, model, fallback) (increase(agent_llm_cost_cny_total{job=~\"aishop-agent(-worker)?\"}[1h]))",
          "legendFormat": "{{model}} / fallback={{fallback}} / {{kind}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "未定价 LLM token 速率",
      "description": "模型返回了真实 usage，但价格表没有该模型；该值大于 0 时成本面板不完整",
      "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 74 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind, model, fallback) (rate(agent_llm_unpriced_tokens_total{job=~\"aishop-agent(-worker)?\"}[5m]))",
          "legendFormat": "{{model}} / fallback={{fallback}} / {{kind}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "意图结构化输出结果速率",
      "description": "schema_success 为 provider schema 成功；fallback 为文本 JSON 兼容路径；invalid 会进入安全澄清意图",
      "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 80 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(agent_intent_schema_total{job=~\"aishop-agent(-worker)?\"}[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "订单自然语言解析结果",
      "description": "按固定 intent / outcome 观察唯一命中、多候选、无匹配、无资格和依赖故障；不含用户或订单标签",
      "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 86 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (intent, outcome) (rate(agent_order_reference_total{job=~\"aishop-agent(-worker)?\"}[5m]))",
          "legendFormat": "{{intent}} / {{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "订单解析延迟与候选选择",
      "description": "解析 p95 与候选卡选择结果；selection 指标只使用 intent / outcome 低基数标签",
      "datasource": { "type": "prometheus", "uid": "aishop-prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 86 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(agent_order_reference_latency_seconds_bucket{job=~\"aishop-agent(-worker)?\"}[5m])))",
          "legendFormat": "解析 p95（秒）"
        },
        {
          "refId": "B",
          "expr": "sum by (intent, outcome) (rate(agent_order_selection_total{job=~\"aishop-agent(-worker)?\"}[5m]))",
          "legendFormat": "选择 {{intent}} / {{outcome}}"
        }
      ]
    }
  ]
}
