# ============ 服务端口（HTTP + WebSocket 同端口） ============
APP_HOST=0.0.0.0
APP_PORT=7050
JAVA_WEB_URL=http://localhost:8080

# ============ Java 微服务（Agent 只连 simlect_agent 库，跨域走 HTTP） ============
ORDER_SERVICE_URL=http://127.0.0.1:8093
PRODUCT_SERVICE_URL=http://127.0.0.1:8099
COUPON_SERVICE_URL=http://127.0.0.1:8087
USER_SERVICE_URL=http://127.0.0.1:8105
SIMLECT_INTERNAL_TOKEN=your-token

# ============ LLM ============
LLM_API_KEY=your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_FALLBACK_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# ============ 记忆摘要 LLM（可与主对话分离；留空则回落主 LLM） ============
MEMORY_LLM_API_KEY=
MEMORY_LLM_BASE_URL=
MEMORY_LLM_MODEL=
MEMORY_LLM_TIMEOUT=

# ============ Embedding ============
EMBEDDING_API_KEY=your-dashscope-api-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# ============ MySQL（复用 Java 库） ============
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=simlect_agent

# ============ Redis ============
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ============ Elasticsearch ============
ES_HOSTS=http://localhost:9200
ES_INDEX=myshop_vectorstore
ES_VECTOR_DIMENSIONS=1024

# ============ RabbitMQ（与 deploy/docker-compose.middleware.yml 一致） ============
RABBITMQ_URL=amqp://simlect:simlect@localhost:5672/

# ============ Agent 配置 ============
AI_CHAT_LIMIT=200
RAG_TOP_K=15
RAG_SCORE_THRESHOLD=0.5
HISTORY_MESSAGE_LIMIT=15
TASK_QUEUE_MAX=300

# ============ 熔断 ============
CIRCUIT_LLM_FAILURE_THRESHOLD=5
CIRCUIT_LLM_RECOVERY_TIMEOUT=60
