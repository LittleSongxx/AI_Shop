    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^26.1.0",
    "postcss-px-to-viewport": "^1.1.1",
    "sass": "^1.100.0",
    "sharp": "^0.34.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.2.8"
